#compdef archivectl
# zsh completion for archivectl: commands, options, directories where one
# is wanted, the archive numbers list prints with their dates, and the paths
# in an archive after its number; borg runs only when it needs no
# passphrase typed

# in DIR [ID PREFIX]: the records of archivectl list for the source of DIR,
# or the items of archive ID below PREFIX, "type path"; only when the
# passphrase is in the environment or .borgbackup sets BORG_PASSCOMMAND, and
# with gpg kept from asking for its own
_archivectl_borg='dir=$(realpath -- "$1") || exit 1
until [ -f "$dir/.borgbackup" ]; do [ "$dir" != / ] || exit 1; dir=$(dirname "$dir"); done
cd "$dir" && source ./.borgbackup >/dev/null 2>&1 || exit 1
[ -n "${BORG_PASSPHRASE:-}${BORG_PASSCOMMAND:-}" ] || exit 1
export BORG_PASSCOMMAND BORG_RSH BORG_RELOCATED_REPO_ACCESS_IS_OK=no BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=no
export PASSWORD_STORE_GPG_OPTS="${PASSWORD_STORE_GPG_OPTS:-} --pinentry-mode=error"
[ $# -gt 1 ] || exec archivectl list
name=$(borg list --short --glob-archives "${2}_*" "$BORG_REPO" | head -n 1)
exec borg list --format "{type} {path}{NL}" "$BORG_REPO::${name:-$2}" "sh:$3*"'

# _archivectl_ids: the archive numbers of the source of cdir, their dates as descriptions
_archivectl_ids() {
  local -a ids
  ids=(${(f)"$(bash -c "$_archivectl_borg" _ "$cdir" </dev/null 2>/dev/null | awk -F '\t' '{ gsub(/:/, "\\:", $2); print $1 ":" $2 }')"})
  _describe -t archives 'archive' ids
}

# _archivectl_paths: the paths in the archive the first operand names, one level below the current word
_archivectl_paths() {
  local prefix="" item
  local -a dirs files
  [[ $PREFIX == */* ]] && prefix=${PREFIX%/*}/
  for item in ${(f)"$(bash -c "$_archivectl_borg" _ "$cdir" "$line[1]" "$prefix" </dev/null 2>/dev/null)"}; do
    [[ ${item#? } == . || ${${item#? }#$prefix} == */* ]] && continue
    if [[ $item == d\ * ]]; then dirs+=("${item#? }/"); else files+=("${item#? }"); fi
  done
  compadd -S '' -a dirs
  compadd -a files
}

_archivectl() {
  local curcontext="$curcontext" state line cdir
  local -A opt_args
  local -a commands
  commands=(
    'init:make a directory a backup source'
    'create:archive the source into a new archive'
    'status:print the source and its repository'
    'list:print each archive\: number, date, size'
    'delete:delete the archives named or piped in'
    'restore:extract an archive, or paths in it'
    'diff:print the paths that differ'
    'check:check the repository with borg check'
    'export-key:print the key of the repository'
    'change-passphrase:give the repository a new passphrase'
    'initialise:same as init'
  )
  _arguments -C \
    '-C[run in <dir>]:directory:_files -/' \
    '(-h --help)'{-h,--help}'[this help]' \
    '1: :->command' \
    '*:: :->args' && return
  cdir=${${opt_args[-C]:-.}/#\~/$HOME}
  case $state in
    command) _describe -t commands 'archivectl command' commands ;;
    args)
      case $words[1] in
        (init|initialise) _arguments \
            '(-n --dry-run)'{-n,--dry-run}'[Report what would be written and write nothing.]' \
            '--repo[Use the repository at <url>.]:url:' \
            '--no-pass[Keep the passphrase out of pass.]' \
            '--store-passphrase[Keep the passphrase of an initialised source in pass.]' \
            '(-h --help)'{-h,--help}'[Print the help of init.]' \
            '1:directory:_files -/' ;;
        (create) _arguments \
            '(-n --dry-run)'{-n,--dry-run}'[Report what would be renamed and archived and write nothing.]' \
            '--stats[Also print the statistics borg gives.]' \
            '(-h --help)'{-h,--help}'[Print the help of create.]' ;;
        (status|check) _arguments \
            '(-h --help)'{-h,--help}'[Print the help of the command.]' ;;
        (export-key) _arguments \
            '--paper[The form for typing the key back by hand.]' \
            '(-h --help)'{-h,--help}'[Print the help of export-key.]' ;;
        (change-passphrase) _arguments \
            '(-n --dry-run)'{-n,--dry-run}'[Report what would change and change nothing.]' \
            '(-h --help)'{-h,--help}'[Print the help of change-passphrase.]' ;;
        (list) _arguments \
            '--older[Only the archives older than N days.]:N:' \
            '--newer[Only the archives newer than N days.]:N:' \
            '--first[Then only the oldest N of those.]:N:' \
            '--last[Then only the newest N of those.]:N:' \
            '(-h --help)'{-h,--help}'[Print the help of list.]' ;;
        (delete) _arguments \
            '(-n --dry-run)'{-n,--dry-run}'[Report what would be renamed and deleted and change nothing.]' \
            '(-h --help)'{-h,--help}'[Print the help of delete.]' \
            '*:archive:_archivectl_ids' ;;
        (restore) _arguments \
            '(-n --dry-run)'{-n,--dry-run}'[Report what would be extracted or mounted and write nothing.]' \
            '(--mount)--to[Extract into <dir> instead.]:directory:_files -/' \
            '(--to)--mount[Mount the archive at <dir> instead.]:directory:_files -/' \
            '(-h --help)'{-h,--help}'[Print the help of restore.]' \
            '1:archive:_archivectl_ids' \
            '*:path:_archivectl_paths' ;;
        (diff) _arguments \
            '--scratch[Extract the archive under <dir> to compare it with the live source.]:directory:_files -/' \
            '(-h --help)'{-h,--help}'[Print the help of diff.]' \
            '1:archive:_archivectl_ids' \
            '2::archive:_archivectl_ids' ;;
      esac ;;
  esac
}

_archivectl "$@"
