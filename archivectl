#!/bin/bash
#
# archivectl - encrypted, compressed Borg archives of a directory tree
#
# Commands: init, create, status, list, delete, restore, diff, check
# Run 'archivectl --help' for more information.
#

set -o errexit
set -o nounset
set -o pipefail

SCRIPT_PATH="$(realpath "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
PROG=archivectl
CONFIG=.borgbackup

# make install writes its LIBDIR here
INSTALLED_MODULE_DIR=""

# Installed, the modules and the library are in LIBDIR; in the source tree
# the modules are in libexec/ and the library in lib/; a copy made by hand
# looks in PREFIX/lib/archivectl/.
if [ -n "$INSTALLED_MODULE_DIR" ]; then
    MODULE_DIR="$INSTALLED_MODULE_DIR"
    LIB_DIR="$MODULE_DIR"
elif [ -d "$SCRIPT_DIR/libexec/$PROG" ]; then
    MODULE_DIR="$SCRIPT_DIR/libexec/$PROG"
    LIB_DIR="$SCRIPT_DIR/lib"
else
    MODULE_DIR="$(dirname "$SCRIPT_DIR")/lib/$PROG"
    LIB_DIR="$MODULE_DIR"
fi
source "$LIB_DIR/common.sh"

BORG_BACKUP_ROOT="${BORG_BACKUP_ROOT:-$(default_root borg "$HOME/.borg_backups")}"
# the passphrase this run read, for its borg calls only
unset READ_PASSPHRASE

usage() {
    cat <<'EOF'
usage: archivectl [-C <dir>] <command> [<options>]

  init [-n] [--repo <url>] [<path>]
                                make a directory a backup source
  create [-n]                   archive the source into a new archive
  status                        print the source and its repository
  list [--older N] [--newer N] [--first N] [--last N]
                                print each archive: number, date, size
  delete [-n] [<id>...]         delete the archives named or piped in
  restore [-n] [--to <dir>] ... <id> [<path>...]
                                extract an archive, or paths in it
  diff [--scratch <dir>] <id> [<id2>]
                                print the paths that differ
  check                         check the repository with borg check
  export-key [--paper]          print the key of the repository
  change-passphrase [-n]        give the repository a new passphrase

  -C <dir> run in <dir>; -n report only, write nothing; -h print this help

  archivectl init && archivectl create
  archivectl list --older 30 | archivectl delete -n

archivectl <command> --help and man archivectl for the details.
EOF
    exit "${1:-0}"
}

# Awk functions for the programs that read borg's output, run with
# LC_ALL=C: hex reads up to 8 hex digits, utf8 writes a code point as UTF-8,
# unjson decodes a JSON string, \udcXX being a byte that is not UTF-8, and
# shown writes such bytes as ?, the way borg shows a path.
AWK_JSON='
BEGIN { for (i = 1; i < 256; i++) byte[sprintf("%c", i)] = i }
function hex(h,    i, v) {
    v = 0
    for (i = 1; i <= length(h); i++) v = v * 16 + index("0123456789abcdef", tolower(substr(h, i, 1))) - 1
    return v
}
function utf8(c) {
    if (c < 128) return sprintf("%c", c)
    if (c < 2048) return sprintf("%c%c", 192 + int(c / 64), 128 + c % 64)
    if (c < 65536) return sprintf("%c%c%c", 224 + int(c / 4096), 128 + int(c / 64) % 64, 128 + c % 64)
    return sprintf("%c%c%c%c", 240 + int(c / 262144), 128 + int(c / 4096) % 64, 128 + int(c / 64) % 64, 128 + c % 64)
}
function unjson(s,    out, i, c, code) {
    out = ""
    for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c != "\\") { out = out c; continue }
        c = substr(s, ++i, 1)
        if (c != "u") { out = out (c == "n" ? "\n" : c == "t" ? "\t" : c == "r" ? "\r" : c == "b" ? "\b" : c == "f" ? "\f" : c); continue }
        code = hex(substr(s, i + 1, 4)); i += 4
        if (code >= 55296 && code < 56320 && substr(s, i + 1, 2) == "\\u") {
            code = 65536 + (code - 55296) * 1024 + hex(substr(s, i + 3, 4)) - 56320; i += 6
        }
        if (code >= 56448 && code < 56576) out = out sprintf("%c", code - 56320)
        else if (code >= 55296 && code < 57344) out = out "?"
        else out = out utf8(code)
    }
    return out
}
function shown(s,    out, i, n, b, c, need, j, ok) {
    if (s !~ /[\200-\377]/) return s
    out = ""; n = length(s)
    for (i = 1; i <= n; i++) {
        b = byte[substr(s, i, 1)]
        if (b < 128) { out = out substr(s, i, 1); continue }
        need = (b >= 194 && b <= 223) ? 1 : (b >= 224 && b <= 239) ? 2 : (b >= 240 && b <= 244) ? 3 : 0
        ok = need > 0 && i + need <= n
        for (j = 1; ok && j <= need; j++) { c = byte[substr(s, i + j, 1)]; if (c < 128 || c > 191) ok = 0 }
        if (ok && need >= 2) {
            c = byte[substr(s, i + 1, 1)]
            if ((b == 224 && c < 160) || (b == 237 && c > 159) || (b == 240 && c < 144) || (b == 244 && c > 143)) ok = 0
        }
        if (ok) { out = out substr(s, i, need + 1); i += need } else out = out "?"
    }
    return out
}'

# borg ARG...: borg, with the passphrase this run read, if it read one, in
# its environment only
borg() {
    if [ -n "${READ_PASSPHRASE+set}" ]; then
        BORG_PASSPHRASE="$READ_PASSPHRASE" command borg "$@"
    else
        command borg "$@"
    fi
}

# is_remote LOCATION: whether LOCATION is a repository on another host,
# ssh://user@host/path or user@host:path
is_remote() {
    [[ "$1" == ssh://* || "$1" =~ ^[^/:]+: ]]
}

# repository_exists LOCATION: whether a Borg repository is at LOCATION; on
# another host borg itself answers, and any error but a missing repository
# ends the run with borg's status
repository_exists() {
    local status=0 output
    if ! is_remote "$1"; then
        [ -e "$1/config" ]
        return
    fi
    output=$(BORG_PASSPHRASE="" BORG_EXIT_CODES=modern command borg info "$1" 2>&1 >/dev/null) || status=$?
    case "$status" in
        0|52) return 0 ;;
        13) return 1 ;;
        *)
            printf '%s\n' "$output" >&2
            die "borg cannot open $1 (borg status $status)." "$status"
            ;;
    esac
}

# enter_repository VAR...: enter_repo, export for borg the BORG_PASSCOMMAND
# and BORG_RSH the configuration sets, and ask for the passphrase if borg would
enter_repository() {
    enter_repo "$@"
    [ -z "${BORG_PASSCOMMAND:-}" ] || export BORG_PASSCOMMAND
    [ -z "${BORG_RSH:-}" ] || export BORG_RSH
    ask_passphrase
}

# ask_passphrase: with neither BORG_PASSPHRASE nor BORG_PASSCOMMAND set,
# READ_PASSPHRASE for every borg call of this run, so that borg asks for
# nothing: read once from the terminal when the repository needs one, else
# empty; with no terminal on stderr it dies instead of asking
ask_passphrase() {
    local status=0
    [ -z "${BORG_PASSPHRASE+set}" ] && [ -z "${BORG_PASSCOMMAND:-}" ] || return 0
    READ_PASSPHRASE=""
    BORG_PASSPHRASE="" BORG_EXIT_CODES=modern command borg info "$BORG_REPO" >/dev/null 2>&1 || status=$?
    [ "$status" -eq 52 ] || return 0
    [ -t 2 ] && { : </dev/tty; } 2>/dev/null ||
        die "$BORG_REPO needs its passphrase: keep it in pass with $PROG init --store-passphrase, or set BORG_PASSCOMMAND or BORG_PASSPHRASE."
    IFS= read -rs -p "Enter passphrase for $BORG_REPO: " READ_PASSPHRASE </dev/tty
    printf '\n' >&2
}

# An archive is named N_YYYY-MM-DD_HHMMSS, N its number; an archive named
# otherwise is not archivectl's and is left out.
NUMBERED='^[1-9][0-9]*_[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]$'

# sequence_file: where the last number given to an archive of BORG_REPO is
# kept, beside the logs, since a repository on another host has no room for it
sequence_file() {
    printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/$PROG/$(safe_name "$BORG_REPO").sequence"
}

# last_number: the last number an archive was given; 0 before the first
last_number() {
    local n="" file
    file=$(sequence_file)
    [ ! -s "$file" ] || read -r n <"$file" || true
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    printf '%s\n' "$n"
}

# archive_entries: "number<TAB>date<TAB>name<TAB>borg id" of every numbered
# archive, by number, the date YYYY-MM-DD HH:MM:SS of its start. A failing
# borg list ends it with borg's status.
archive_entries() {
    local listing
    listing=$(borg list --format '{barchive}{TAB}{start:%Y-%m-%d %H:%M:%S}{TAB}{id}{NL}' "$BORG_REPO") || return
    [ -n "$listing" ] || return 0
    LC_ALL=C awk -F '\t' -v OFS='\t' -v numbered="$NUMBERED" '
        $1 ~ numbered { print substr($1, 1, index($1, "_") - 1) + 0, $2, $1, $3 }' <<<"$listing" |
        LC_ALL=C sort -t "$(printf '\t')" -k1,1n
}

# next_number: NUMBER, the one after the last given and every one shown, so
# that no number comes back after a delete
next_number() {
    local last top
    last=$(last_number)
    top=$(archive_entries | tail -n 1 | cut -f1)
    NUMBER=$((${top:-0} > last ? ${top:-0} + 1 : last + 1))
}

# lock_sequence, unlock_sequence: take and give back the lock on the
# sequence file, so that two runs never give out one number
lock_sequence() {
    SEQUENCE=$(sequence_file)
    ( umask 077 && mkdir -p "$(dirname "$SEQUENCE")" && : >>"$SEQUENCE" )
    exec {SEQUENCE_FD}>>"$SEQUENCE"
    flock "$SEQUENCE_FD"
}
unlock_sequence() {
    exec {SEQUENCE_FD}>&-
}

# require_archive ID...: NUMBERS and NAMES, the number and the name of the
# archive each ID names by its number or its name, once each; dies unless
# every ID names one
require_archive() {
    local entries id found
    local -a missing=()
    NUMBERS=() NAMES=()
    entries=$(archive_entries)
    for id in "$@"; do
        found=$(ID="$id" LC_ALL=C awk -F '\t' '$1 "" == ENVIRON["ID"] "" || $3 "" == ENVIRON["ID"] "" { print $1 "\t" $3; exit }' <<<"$entries")
        if [ -z "$found" ]; then
            missing+=("$id")
        elif [[ " ${NUMBERS[*]} " != *" ${found%%$'\t'*} "* ]]; then
            NUMBERS+=("${found%%$'\t'*}")
            NAMES+=("${found#*$'\t'}")
        fi
    done
    [ ${#missing[@]} -eq 0 ] || die "no such archive: ${missing[*]}"
}

# with_sizes: every entry "number<TAB>date<TAB>name<TAB>borg id" read on
# stdin as the record "number<TAB>date<TAB>size", the size the original
# size in bytes of the archive
with_sizes() {
    local entries info
    entries=$(cat)
    [ -n "$entries" ] || return 0
    info=$(borg info --json --glob-archives '*' "$BORG_REPO")
    awk -F '\t' -v OFS='\t' '
        NR == FNR {
            if ($0 ~ /^ *"id": "/) { id = $0; gsub(/^ *"id": "|",?$/, "", id) }
            if ($0 ~ /^ *"original_size": /) { size = $0; gsub(/[^0-9]/, "", size); sizes[id] = size }
            next
        }
        { print $1, $2, sizes[$4] }
    ' <(printf '%s\n' "$info") <(printf '%s\n' "$entries")
}

while [ $# -gt 0 ]; do
    case "$1" in
        -C)
            [ $# -gt 1 ] || die "-C needs a directory." $EXIT_INVALID_ARGS
            cd -- "$2" 2>/dev/null || die "cannot change into '$2'." $EXIT_INVALID_ARGS
            shift 2
            ;;
        -h|--help) usage 0 ;;
        -*) die "unknown option '$1'; see $PROG --help" $EXIT_INVALID_ARGS ;;
        *) break ;;
    esac
done
# with no command, the status of the source here, then the help
if [ $# -eq 0 ]; then
    status=0
    ( source "$MODULE_DIR/status.sh" && run ) || status=$?
    usage "$status"
fi
COMMAND="$1"
shift
case "$COMMAND" in
    init|initialise) source "$MODULE_DIR/init.sh" ;;
    create|status|list|delete|restore|diff|check|export-key|change-passphrase) source "$MODULE_DIR/$COMMAND.sh" ;;
    *) die "unknown command '$COMMAND'; see $PROG --help" $EXIT_INVALID_ARGS ;;
esac
run "$@"
